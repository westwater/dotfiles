# Ghostty config — ported from kitty.conf. Linked to ~/.config/ghostty/config by link.sh.
# Validate: /Applications/Ghostty.app/Contents/MacOS/ghostty +validate-config
# Reload in a running Ghostty: cmd+shift+,

# --- Font ---------------------------------------------------------------
# MesloLGS (powerlevel10k), from brew's font-meslo-lg-nerd-font
font-family = MesloLGS Nerd Font Mono
font-size = 11
# kitty: modify_font cell_height 130% / baseline 2 / adjust_column_width -1
adjust-cell-height = 30%
adjust-font-baseline = 2
adjust-cell-width = -1

# --- Colours (same palette as kitty.conf) -------------------------------
background = #20242d
foreground = #c7c7c7
selection-background = #4d4f4c
background-opacity = 1.0

palette = 0=#1b1d1e
palette = 8=#505354
palette = 1=#AF4B58
palette = 9=#fd6f6b
palette = 2=#93b379
palette = 10=#67f86f
palette = 3=#E5C178
palette = 11=#fffa72
palette = 4=#7184af
palette = 12=#6a76fb
palette = 5=#c839c5
palette = 13=#fd7cfc
palette = 6=#20c5c6
palette = 14=#68fdfe
palette = 7=#c5c5be
palette = 15=#dadad5

# --- Window -------------------------------------------------------------
window-padding-x = 5
window-padding-y = 5
macos-titlebar-style = tabs
quit-after-last-window-closed = true
split-divider-color = #363D45

# Remote hosts (the lab etc.) lack xterm-ghostty terminfo; fall back to
# TERM=xterm-256color over ssh instead of breaking backspace/clear there.
shell-integration-features = ssh-env

# --- Keybinds -----------------------------------------------------------
# Ghostty's macOS defaults already cover kitty's cmd+t / cmd+d / cmd+shift+d /
# cmd+w / cmd+c / cmd+v, opt+arrow word jumps and cmd+arrow line start/end.
# kitty's tab switching, which replaces Ghostty's default split focus on
# these keys (cmd+[ / cmd+] still move between splits):
keybind = super+alt+arrow_right=next_tab
keybind = super+alt+arrow_left=previous_tab

# Linux (kitty's ctrl+shift / alt split bindings)
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+s=new_split:down
keybind = alt+d=new_split:right
keybind = alt+shift+d=new_split:down
keybind = ctrl+shift+w=close_surface
keybind = alt+w=close_surface
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
